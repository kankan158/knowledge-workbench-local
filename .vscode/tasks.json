{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: install",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "group": "build"
    },
    {
      "label": "backend: run",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "group": "build"
    },
    {
      "label": "frontend: run",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev", "--", "--host", "localhost", "--port", "4173", "--strictPort"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: backend + frontend",
      "dependsOn": ["backend: run", "frontend: run"],
      "dependsOrder": "parallel",
      "group": "build"
    }
  ]
}
